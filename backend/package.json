{
  "name": "alquiler-audiovisual-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --experimental-strip-types src/database/cli.ts up",
    "db:rollback": "node --experimental-strip-types src/database/cli.ts down",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "express": "^5.0.0",
    "jose": "^6.2.18",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  }
}
